{
  "schema": "WORKBRIDGE_DESKTOP_COMMANDER_DUPLICATE_MATRIX_V1",
  "reference": {
    "repository": "wonderwhy-er/DesktopCommanderMCP",
    "head": "550a0b3e31da18b7cf25e87ed840e3d953b6da42",
    "version": "0.2.51",
    "license": "MIT"
  },
  "implementation": {
    "workstation_owner": "exact upstream DesktopCommanderMCP source",
    "distribution_owner": "WorkBridgeMCP",
    "transport_owner": "VeraMesh",
    "relay_owner": "VeraRelay",
    "tool_semantics": "UPSTREAM_EXACT"
  },
  "capabilities": [
    {
      "id": "process.command_string",
      "upstream": [
        "start_process"
      ],
      "status": "DIRECT_UPSTREAM",
      "requirement": "arbitrary command string preserved"
    },
    {
      "id": "process.session_io",
      "upstream": [
        "read_process_output",
        "interact_with_process",
        "force_terminate",
        "list_sessions"
      ],
      "status": "DIRECT_UPSTREAM"
    },
    {
      "id": "process.os",
      "upstream": [
        "list_processes",
        "kill_process"
      ],
      "status": "DIRECT_UPSTREAM"
    },
    {
      "id": "filesystem.core",
      "upstream": [
        "read_file",
        "read_multiple_files",
        "write_file",
        "create_directory",
        "list_directory",
        "move_file",
        "get_file_info",
        "edit_block"
      ],
      "status": "DIRECT_UPSTREAM"
    },
    {
      "id": "search.streaming",
      "upstream": [
        "start_search",
        "get_more_search_results",
        "stop_search",
        "list_searches"
      ],
      "status": "DIRECT_UPSTREAM"
    },
    {
      "id": "history.local",
      "upstream": [
        "get_recent_tool_calls"
      ],
      "status": "DIRECT_UPSTREAM"
    },
    {
      "id": "documents",
      "upstream": [
        "write_pdf"
      ],
      "status": "DIRECT_UPSTREAM"
    },
    {
      "id": "config",
      "upstream": [
        "get_config",
        "set_config_value"
      ],
      "status": "DIRECT_UPSTREAM"
    },
    {
      "id": "device.transport",
      "owner": "VeraMesh",
      "status": "VERAMESH_SECURE_MCP_TUNNEL",
      "requirement": "must not alter upstream MCP tool schemas or payloads"
    },
    {
      "id": "relay",
      "owner": "VeraRelay",
      "status": "TRANSPARENT_OPTIONAL_PATH",
      "requirement": "if used, forward calls/results without semantic narrowing"
    }
  ]
}
